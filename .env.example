# ==============================================================================
# BEL CODE — Environment Variable Template (.env.example)
# ==============================================================================
# Copy this file to `.env` (never commit `.env` to Git!) or export variables in
# your shell, OR configure keys encrypted inside the UI Settings / Setup Wizard.
#
# Never put real API keys in committed files. Every user connects their own key.
# ==============================================================================

# --- Free Cloud AI Providers (No Credit Card Required) ------------------------
# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# OpenRouter (:free models & openrouter/free — https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=

# Mistral AI Free Mode (https://console.mistral.ai/api-keys/)
MISTRAL_API_KEY=

# Cloudflare Workers AI (https://dash.cloudflare.com/)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# NVIDIA NIM API (https://build.nvidia.com/settings/api-keys)
NVIDIA_API_KEY=

# SambaNova Cloud (https://cloud.sambanova.ai/apis)
SAMBANOVA_API_KEY=

# Cerebras Cloud (https://cloud.cerebras.ai/)
CEREBRAS_API_KEY=

# Hugging Face Inference Providers ($0.10/mo free credits — https://huggingface.co/settings/tokens)
HF_TOKEN=

# GitHub Models Playground (https://github.com/settings/tokens)
GITHUB_TOKEN=

# --- Local AI & Self-Hosted Routers -------------------------------------------
# Ollama (https://ollama.com/) — No API key required
OLLAMA_HOST=http://localhost:11434

# Local FreeLLMAPI Gateway (optional unified local router on port 31415 or 3001)
FREELLM_API_KEY=

# --- Paid / Bring-Your-Own Endpoints ------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
TOKENHARBOR_API_KEY=
BEL_CODE_CUSTOM_API_KEY=
